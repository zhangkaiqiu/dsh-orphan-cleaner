{
  "name": "dsh-orphan-cleaner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scan and terminate orphan processes (MCP stdio connectors, dev servers, stray process trees) left behind by DSH restarts.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "orphan-process",
    "process-cleanup",
    "mcp",
    "windows"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangkaiqiu/dsh-orphan-cleaner.git"
  },
  "homepage": "https://github.com/zhangkaiqiu/dsh-orphan-cleaner#readme",
  "bugs": {
    "url": "https://github.com/zhangkaiqiu/dsh-orphan-cleaner/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
